FROM rust:1.91-bookworm@sha256:c1e5f19e773b7878c3f7a805dd00a495e747acbdc76fb2337a4ebf0418896b33 AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p philosophy-extractor-worker

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
COPY --from=builder /app/target/release/philosophy-extractor /usr/local/bin/philosophy-extractor
ENTRYPOINT ["philosophy-extractor"]
